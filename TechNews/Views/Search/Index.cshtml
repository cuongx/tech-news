@model TechNews.Models.SearchViewModel
@{Layout="~/Views/Shared/_Layout.cshtml";ViewData["Title"]="Tìm kiếm bài viết";}
<div class="container py-5"><h1>Kết quả tìm kiếm</h1><div asp-validation-summary="All" class="text-danger"></div>
<form method="get" action="/Search" class="row mb-4">
<div class="col-md-4"><label for="filter-q">Từ khóa</label><input id="filter-q" name="q" value="@Model.Q" class="form-control"/></div>
<div class="col-md-4"><label for="filter-category">Chuyên mục</label><select id="filter-category" name="categoryId" class="form-control"><option value="">Tất cả</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.CategoryName</option>}</select></div>
<div class="col-md-4"><label for="filter-tag">Tag</label><select id="filter-tag" name="tagId" class="form-control"><option value="">Tất cả</option>@foreach(var t in Model.Tags){<option value="@t.Id" selected="@(Model.TagId==t.Id)">@t.Name</option>}</select></div>
<div class="col-md-4"><label>Từ ngày <input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control"/></label></div><div class="col-md-4"><label>Đến ngày <input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control"/></label></div><div class="col-md-4"><button class="btn btn-primary my-3">Tìm kiếm</button></div></form>
<p>@Model.Total kết quả</p>@if(Model.Total==0){<p>Không tìm thấy bài viết phù hợp.</p>}
@foreach(var article in Model.Articles){<article class="row border-bottom py-3"><div class="col-sm-3"><img src="@article.ArticleThumb" alt="" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover"/></div><div class="col-sm-9"><h2 class="h4"><a asp-controller="Home" asp-action="DetailsArticle" asp-route-slug="@article.ArticleTitle.Replace(" ","-")" asp-route-id="@article.Id">@article.ArticleTitle</a></h2><p>@article.ArticleDescription</p><small>@article.Category?.CategoryName · @article.ArticleDate.ToString("dd/MM/yyyy")</small></div></article>}
<nav aria-label="Phân trang" class="my-3">@for(var i=Math.Max(1,Model.Page-2);i<=Math.Min(Model.Pages,Model.Page+2);i++){<a class="btn @(i==Model.Page?"btn-primary":"btn-outline-primary")" href="@Url.Action("Index","Search",new{q=Model.Q,categoryId=Model.CategoryId,tagId=Model.TagId,from=Model.From?.ToString("yyyy-MM-dd"),to=Model.To?.ToString("yyyy-MM-dd"),page=i})">@i</a>}</nav></div>

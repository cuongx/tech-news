@model ShopOrder
@{var culture=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
<p><span class="shop-status">@OrderStates.Label(Model.Status)</span> · @Model.CreatedUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (giờ Việt Nam)</p><div class="shop-checkout"><div><h2>Thông tin nhận hàng</h2><p><strong>@Model.Recipient</strong><br />@Model.Phone</p><p>@Model.Address</p>@if(!string.IsNullOrWhiteSpace(Model.Note)){<p>Ghi chú: @Model.Note</p>}<p>Thanh toán: COD — @(Model.Status=="Completed"?"Đã thu tiền":Model.Status=="Cancelled"?"Đơn đã hủy":"Thanh toán khi nhận hàng")</p></div><div class="shop-summary"><h2>Sản phẩm</h2>@foreach(var item in Model.Items){<p>@item.ProductName × @item.Quantity<br /><strong>@((item.UnitPrice*item.Quantity).ToString("N0",culture)) ₫</strong></p>}<hr /><p>Phí giao hàng: 0 ₫</p><p>Tổng: <strong class="shop-price">@Model.Total.ToString("N0",culture) ₫</strong></p></div></div>

@model List<Product>
@{ViewData["Title"]="Quản lý sản phẩm";var culture=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
<section class="shop-shell container-fluid"><div class="shop-heading"><div><h1>Sản phẩm</h1></div><a href="/Admin/Products/Create" class="shop-button">+ Thêm sản phẩm</a></div>@if(TempData["Message"]!=null){<div class="alert alert-info" role="status">@TempData["Message"]</div>}<form method="get" class="shop-filters"><label>Tìm sản phẩm<input name="q" value="@ViewBag.Q" /></label><button class="shop-button">Tìm</button></form><div class="shop-table-wrap"><table class="table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Hiển thị</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Category</td><td>@p.Price.ToString("N0",culture) ₫</td><td>@p.Stock</td><td>@(p.IsActive?"Đang bán":"Đã ẩn")</td><td><a href="/Admin/Products/@p.Id/Edit">Chỉnh sửa</a></td></tr>}</tbody></table></div>@if(Model.Count==0){<p>Chưa có sản phẩm. Thêm sản phẩm, giá bán và tồn kho để bắt đầu.</p>}<nav class="shop-pagination">@if(ViewBag.Page>1){<a href="@Url.Action("Products",new{q=ViewBag.Q,page=ViewBag.Page-1})">← Trước</a>}<span>Trang @ViewBag.Page / @ViewBag.Pages</span>@if(ViewBag.Page<ViewBag.Pages){<a href="@Url.Action("Products",new{q=ViewBag.Q,page=ViewBag.Page+1})">Sau →</a>}</nav></section>

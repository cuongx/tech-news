@model Product
@{ViewData["Title"]=Model.Id==0?"Thêm sản phẩm":"Sửa sản phẩm";}
<link rel="stylesheet" href="~/css/admin-products.css" asp-append-version="true" />
<section class="shop-shell container-fluid product-editor">
 <a href="/Admin/Products">← Danh sách sản phẩm</a><h1>@ViewData["Title"]</h1><p class="shop-muted">Thông tin dùng trong danh mục và khi khách đặt hàng.</p>
 <form method="post" action="/Admin/Products/Save" id="product-form">
  @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" />
  <div asp-validation-summary="All" class="product-errors" role="alert"></div>
  <div class="product-editor-grid">
   <section class="product-editor-panel"><h2>Thông tin sản phẩm</h2>
    <label for="Name">Tên sản phẩm *</label><input asp-for="Name" required maxlength="160" />
    <label for="Category">Danh mục *</label><input asp-for="Category" required maxlength="80" placeholder="Ví dụ: Phụ kiện" />
    <div class="shop-form-row"><div><label for="Price">Giá bán (₫) *</label><input asp-for="Price" type="number" min="1000" max="1000000000" step="1" required aria-describedby="price-help" /><small id="price-help">Nhập số nguyên đồng, không có dấu phân cách.</small></div><div><label for="Stock">Tồn kho *</label><input asp-for="Stock" type="number" min="0" max="1000000" step="1" required aria-describedby="stock-help" /><small id="stock-help">Tồn kho bằng 0: khách không thể đặt mua.</small></div></div>
    <label for="Description">Mô tả</label><textarea asp-for="Description" rows="6" maxlength="4000"></textarea>
    <label class="shop-check product-active"><input asp-for="IsActive" /> Đang bán trên website</label><small>Bỏ chọn để ngừng bán. Đơn hàng cũ giữ tên và giá tại lúc mua.</small>
   </section>
   <section class="product-editor-panel"><h2>Ảnh sản phẩm</h2><label for="ImageUrl">Đường dẫn ảnh</label><input asp-for="ImageUrl" maxlength="500" placeholder="/images/products/phone.svg" aria-describedby="image-help" /><small id="image-help">Dùng đường dẫn /images/... hoặc URL HTTPS.</small><button type="button" id="preview-product-image" class="shop-button secondary" hidden>Xem trước ảnh</button>
    <div class="product-image-preview"><img id="product-image" alt="Ảnh xem trước của sản phẩm" hidden referrerpolicy="no-referrer" /><p id="product-image-status" role="status">Chưa xem trước ảnh.</p></div>
    <noscript><p>Xem trước ảnh cần JavaScript. Bạn vẫn có thể lưu sản phẩm.</p></noscript>
   </section>
  </div>
  <div class="product-editor-actions"><a href="/Admin/Products" class="shop-button secondary">Hủy</a><button type="submit" class="shop-button">Lưu sản phẩm</button></div>
 </form>
</section>
@section Scripts{<script src="~/js/admin-products.js" asp-append-version="true"></script>}

@model List<ShopOrder>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<section class="shop-shell container">
    <div class="shop-heading"><h1>Đơn hàng của tôi</h1><a href="/Shop">Cửa hàng →</a></div>
    <form method="get" action="/Shop/Orders" class="shop-filters">
        <label>Trạng thái
            <select name="status">
                <option value="">Tất cả</option>
                @foreach (var state in new[] { "Pending", "Confirmed", "Shipping", "Completed", "Cancelled" })
                {
                    <option value="@state" selected="@(state == (string)ViewBag.Status)">@OrderStates.Label(state)</option>
                }
            </select>
        </label>
        <button class="shop-button">Lọc đơn hàng</button>
    </form>
    @if (Model.Count == 0)
    {
        <div class="shop-empty">
            @if (string.IsNullOrEmpty((string)ViewBag.Status))
            { <p>Bạn chưa có đơn hàng nào.</p><a href="/Shop">Khám phá sản phẩm →</a> }
            else
            { <p>Không có đơn hàng phù hợp với trạng thái đã chọn.</p><a href="/Shop/Orders">Xem tất cả đơn hàng</a> }
        </div>
    }
    @foreach (var order in Model)
    {
        <article class="shop-cart-line">
            <a href="/Shop/Orders/@order.Id"><strong>Đơn #@order.Id</strong></a>
            <time datetime="@order.CreatedUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@order.CreatedUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time>
            <span class="shop-status">@OrderStates.Label(order.Status)</span>
            <strong>@order.Total.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</strong>
        </article>
    }
    @if (ViewBag.Total > 0)
    {
        <nav class="shop-pagination" aria-label="Phân trang đơn hàng">
            @if (ViewBag.Page > 1)
            { <a href="@Url.Action("Orders", new { status = ViewBag.Status, page = ViewBag.Page - 1 })" rel="prev">← Trước</a> }
            <span>Trang @ViewBag.Page / @ViewBag.Pages · @ViewBag.Total đơn hàng</span>
            @if (ViewBag.Page < ViewBag.Pages)
            { <a href="@Url.Action("Orders", new { status = ViewBag.Status, page = ViewBag.Page + 1 })" rel="next">Sau →</a> }
        </nav>
    }
</section>

@model CheckoutInput
@{ViewData["Title"]="Đặt hàng";var cart=(CartViewModel)ViewBag.Cart;var culture=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
<section class="shop-shell container"><a href="/Shop/Cart">← Giỏ hàng</a><h1>Thông tin giao hàng</h1><div class="shop-checkout"><form method="post" action="/Shop/Checkout" class="shop-form" id="checkout-form">@Html.AntiForgeryToken()<input asp-for="Token" type="hidden" /><div asp-validation-summary="All" class="text-danger" role="alert"></div><label>Người nhận<input asp-for="Recipient" autocomplete="name" required /></label><label>Số điện thoại<input asp-for="Phone" type="tel" autocomplete="tel" required /></label><label>Địa chỉ nhận hàng<textarea asp-for="Address" autocomplete="street-address" required></textarea></label><label>Ghi chú<textarea asp-for="Note"></textarea></label><p><strong>Thanh toán khi nhận hàng (COD)</strong></p><p>Phí giao hàng: 0 ₫. Tổng thanh toán: <strong>@cart.Total.ToString("N0",culture) ₫</strong>.</p><div id="checkout-review" class="order-review" hidden tabindex="-1"><h2>Kiểm tra trước khi đặt</h2><p id="checkout-recipient"></p><p id="checkout-address"></p><p id="checkout-note"></p><p>Thanh toán COD · Miễn phí giao hàng</p><strong>Tổng thanh toán: @cart.Total.ToString("N0",culture) ₫</strong></div><div class="checkout-actions"><button type="button" id="checkout-edit" class="shop-button secondary" hidden>Sửa thông tin</button><button id="checkout-submit" class="shop-button">Xác nhận đặt hàng</button></div></form><aside class="shop-summary"><h2>Đơn hàng của bạn</h2>@foreach(var line in cart.Lines){<p>@line.Product.Name × @line.Quantity <strong>@line.Total.ToString("N0",culture) ₫</strong></p>}<hr /><p class="shop-price">@cart.Total.ToString("N0",culture) ₫</p></aside></div></section>

<script src="~/js/checkout.js" asp-append-version="true" defer></script>

@model TechNews.Models.User
@{
 Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
 ViewData["Title"] = "Hồ sơ cá nhân";
 var displayName=Model.UserName ?? Model.UserLogin ?? "Tài khoản";
 var initial=System.Globalization.StringInfo.GetNextTextElement(string.IsNullOrWhiteSpace(displayName)?"T":displayName.Trim()).ToUpperInvariant();
 var role=User.IsInRole("Admin")?"Quản trị viên":User.IsInRole("Editor")?"Biên tập viên":"Độc giả";
 var message=TempData["Message"] as string;
 var passwordError=TempData["ProfilePasswordError"] as string;
 TempData.Remove("Message");
}
<link href="~/css/admin-profile.css" rel="stylesheet" asp-append-version="true" />
<main class="container-fluid profile-page">
 <header class="profile-heading"><div><h1>Hồ sơ cá nhân</h1><p>Cập nhật thông tin tài khoản và mật khẩu.</p></div><a href="/" class="profile-website">Xem website <i class="fas fa-arrow-up" aria-hidden="true"></i></a></header>
 @if(!string.IsNullOrEmpty(message)){<div class="profile-notice success" role="status"><i class="fas fa-check-circle" aria-hidden="true"></i><span>@message</span></div>}
 <div class="profile-grid">
  <aside class="profile-identity">
   <div class="profile-identity-body">
    <div class="profile-avatar" aria-hidden="true">@initial</div>
    <span class="profile-role"><i class="fas fa-user-shield" aria-hidden="true"></i> @role</span>
    <h2>@displayName</h2><p class="profile-handle">@@@Model.UserLogin</p>
    <div class="profile-contact"><span>Email liên hệ</span><strong>@Model.UserEmail</strong></div>
    <nav class="profile-shortcuts" aria-label="Các phần hồ sơ"><a href="#profile-information"><i class="far fa-user" aria-hidden="true"></i> Thông tin cá nhân <i class="fas fa-chevron-right" aria-hidden="true"></i></a><a href="#profile-security"><i class="fas fa-lock" aria-hidden="true"></i> Mật khẩu & bảo mật <i class="fas fa-chevron-right" aria-hidden="true"></i></a></nav>
   </div>
  </aside>
  <div class="profile-sections">
   <section class="profile-panel" id="profile-information" aria-labelledby="profile-information-title">
    <header class="profile-panel-heading"><div><h2 id="profile-information-title">Thông tin cá nhân</h2><p>Các trường có dấu * là bắt buộc.</p></div></header>
    <form id="profile-form" asp-action="Details" asp-route-id="@Model.Id" method="post">
     @Html.AntiForgeryToken()<input type="hidden" asp-for="Id" />
     <div asp-validation-summary="ModelOnly" class="profile-validation" role="alert"></div>
     <div class="profile-fields">
      <div class="profile-field full"><label asp-for="UserName">Tên hiển thị <span>*</span></label><input asp-for="UserName" required maxlength="50" autocomplete="name" aria-describedby="name-help" /><small id="name-help">Tên xuất hiện trên tài khoản và nội dung của bạn.</small><span asp-validation-for="UserName" class="text-danger"></span></div>
      <div class="profile-field"><label asp-for="UserEmail">Email <span>*</span></label><input asp-for="UserEmail" type="email" required maxlength="50" autocomplete="email" /><span asp-validation-for="UserEmail" class="text-danger"></span></div>
      <div class="profile-field"><label asp-for="UserLogin">Tên đăng nhập <span>*</span></label><input asp-for="UserLogin" required maxlength="50" autocomplete="username" aria-describedby="login-help" /><small id="login-help">Dùng tên này hoặc email để đăng nhập.</small><span asp-validation-for="UserLogin" class="text-danger"></span></div>
     </div>
     <footer class="profile-form-footer"><span id="profile-save-hint" aria-live="polite">Chưa có thay đổi.</span><div><button type="reset" class="profile-button secondary">Hoàn tác</button><button type="submit" class="profile-button"><i class="far fa-save" aria-hidden="true"></i> Lưu thay đổi</button></div></footer>
    </form>
   </section>
   <section class="profile-panel" id="profile-security" aria-labelledby="profile-security-title">
    <header class="profile-panel-heading"><div><h2 id="profile-security-title">Mật khẩu & bảo mật</h2><p>Nhập mật khẩu hiện tại để đổi mật khẩu.</p></div></header>
    <details class="profile-password" open="@(!string.IsNullOrEmpty(passwordError))">
     <summary><span><i class="fas fa-key" aria-hidden="true"></i> Đổi mật khẩu</span><i class="fas fa-chevron-down" aria-hidden="true"></i></summary>
     <form asp-action="ChangePassword" method="post" id="profile-password-form">
      @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
      @if(!string.IsNullOrEmpty(passwordError)){<div class="profile-notice error" role="alert"><i class="fas fa-exclamation-circle" aria-hidden="true"></i><span>@passwordError</span></div>}
      <div class="profile-fields">
       <div class="profile-field full"><label for="oldPassword">Mật khẩu hiện tại</label><div class="profile-password-input"><input type="password" id="oldPassword" name="oldPassword" required autocomplete="current-password" /><button type="button" class="profile-reveal" data-password="oldPassword" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false" hidden><i class="far fa-eye" aria-hidden="true"></i></button></div></div>
       <div class="profile-field full"><label for="newPassword">Mật khẩu mới</label><div class="profile-password-input"><input type="password" id="newPassword" name="newPassword" required minlength="8" maxlength="128" autocomplete="new-password" aria-describedby="password-help" /><button type="button" class="profile-reveal" data-password="newPassword" aria-label="Hiện mật khẩu mới" aria-pressed="false" hidden><i class="far fa-eye" aria-hidden="true"></i></button></div><small id="password-help">Từ 8–128 ký tự. Nên kết hợp chữ, số và ký tự đặc biệt.</small></div>
      </div>
      <div class="profile-password-actions"><button type="reset" class="profile-button secondary">Xóa nội dung</button><button type="submit" class="profile-button"><i class="fas fa-check" aria-hidden="true"></i> Cập nhật mật khẩu</button></div>
     </form>
    </details>
   </section>
  </div>
 </div>
</main>
@section Scripts {<script src="~/js/admin-profile.js" asp-append-version="true"></script>}

@model BlogWebsite.Models.Article
@{
    var homeEditorial = ViewData["HomeEditorial"] as bool? ?? false;
    var homeHero = ViewData["HomeHero"] as bool? ?? false;
}
<article class="news-card" data-article-id="@Model.Id">
    <a class="news-image" href="@Url.Action("DetailsArticle", "Home", new { slug = Model.ArticleTitle.Replace(" ", "-"), id = Model.Id })" tabindex="-1" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(Model.ArticleThumb))
        {
            <img src="@Model.ArticleThumb" alt="" loading="@(homeHero ? "eager" : "lazy")" decoding="async">
        }
        else { <span class="news-placeholder">TECHNEWS</span> }
    </a>
    <div class="news-copy">
        <div class="news-meta">
            <span>@Model.Category?.CategoryName</span>
            @if (!homeEditorial)
            {
                <time datetime="@Model.ArticleDate.ToString("yyyy-MM-dd")">@Model.ArticleDate.ToString("dd/MM/yyyy")</time>
            }
        </div>
        <h2><a href="@Url.Action("DetailsArticle", "Home", new { slug = Model.ArticleTitle.Replace(" ", "-"), id = Model.Id })">@Model.ArticleTitle</a></h2>
        <p>@Model.ArticleDescription</p>
        @if (homeEditorial)
        {
            <div class="home-byline">
                @if (!string.IsNullOrWhiteSpace(Model.Author?.UserName))
                {
                    <span>@Model.Author.UserName</span>
                }
                <time datetime="@Model.ArticleDate.ToString("yyyy-MM-dd")">@Model.ArticleDate.ToString("dd/MM/yyyy")</time>
            </div>
        }
    </div>
</article>

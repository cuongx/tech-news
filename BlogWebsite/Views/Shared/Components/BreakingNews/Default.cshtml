@model List<Article>
@if (Model.Count > 0)
{
    <section class="editorial-featured" aria-label="Tin nổi bật">
        @foreach (var article in Model.Take(3))
        {
            <article class="featured-story">
                <img src="@article.ArticleThumb" alt="" />
                <div><span class="editorial-eyebrow">@article.Category?.CategoryName · NỔI BẬT</span><h2><a href="@Url.Action("DetailsArticle", "Home", new { slug = article.ArticleTitle.Replace(" ", "-"), id = article.Id })">@article.ArticleTitle</a></h2><time datetime="@article.ArticleDate.ToString("yyyy-MM-dd")">@article.ArticleDate.ToString("dd.MM.yyyy")</time></div>
            </article>
        }
    </section>
}

@model IEnumerable<BlogWebsite.Models.Category>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chuyên mục";
}
<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div><h1 class="h3 text-gray-800">Quản lý chuyên mục</h1><p class="mb-0">Có @Model.Count() chuyên mục · @Model.Count(c => c.ShowOnMenu) chuyên mục trên menu</p></div>
        <a class="btn btn-primary mt-2" href="/Admin/CreateCategory">Thêm chuyên mục</a>
    </div>
    <div class="card shadow mb-4">
        <div class="card-header py-3"><strong class="text-primary">Chuyên mục của website</strong><p class="small mb-0 mt-2">Chuyên mục được bật sẽ xuất hiện trên menu theo thứ tự tăng dần. Ẩn khỏi menu không xóa bài viết.</p></div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover" id="categoryTable">
                <thead><tr><th>Thứ tự</th><th>Chuyên mục</th><th>Mô tả</th><th>Menu website</th><th>Thao tác</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.DisplayOrder</td><td><strong>@item.CategoryName</strong><small class="d-block text-muted">ID: @item.Id</small></td>
                        <td>@item.CategoryDescription</td>
                        <td><span class="badge @(item.ShowOnMenu ? "badge-success" : "badge-secondary")">@(item.ShowOnMenu ? "Đang hiển thị" : "Đang ẩn")</span></td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Chỉnh sửa</a>
                            <a class="btn btn-sm btn-light" href="@Url.Action("GetArticlesByCategory", "Home", new { slug = item.CategoryName.Replace(" ", "-"), id = item.Id })">Xem bài viết</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa chuyên mục này? Chuyên mục có bài viết sẽ được giữ lại.');">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

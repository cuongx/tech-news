@model BlogWebsite.Models.Category
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Thêm chuyên mục";
}
<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">@ViewData["Title"]</h1>
    <div class="card shadow mb-4"><div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <div class="form-group"><label asp-for="CategoryName"></label><input asp-for="CategoryName" class="form-control" maxlength="50" required /><span asp-validation-for="CategoryName" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="CategoryDescription"></label><textarea asp-for="CategoryDescription" class="form-control" maxlength="100" rows="2"></textarea><span asp-validation-for="CategoryDescription" class="text-danger"></span></div>
            <div class="form-group"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" class="form-control" min="0" max="999" /><small class="text-muted">Số nhỏ xuất hiện trước trên menu.</small><span asp-validation-for="DisplayOrder" class="text-danger"></span></div>
            <div class="form-group form-check"><input asp-for="ShowOnMenu" class="form-check-input" /><label asp-for="ShowOnMenu" class="form-check-label"></label></div>
            <button type="submit" class="btn btn-primary">Lưu chuyên mục</button>
            <a asp-action="Index" class="btn btn-light ml-2">Quay lại</a>
        </form>
    </div></div>
</div>
